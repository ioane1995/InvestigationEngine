# ---- Copy to .env (never commit .env) ----
APP_ENV=development
ADMIN_API_KEY=change-me            # required for upload/update/delete endpoints when set

# Vector DB: Qdrant Cloud (persistent). Leave QDRANT_URL empty to use local on-disk mode.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant           # use ":memory:" for tests
COLLECTION_PREFIX=ie

# Embeddings: hashing (offline, own implementation) | fastembed (local ONNX) | openai (any OpenAI-compatible API)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# LLM: heuristic (offline extractive, no network) | openai (any OpenAI-compatible chat API with tool calling)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MIN_OUTPUT_TOKENS=2048          # reasoning models need headroom for hidden thinking
#LLM_REASONING_EFFORT=low           # optional (gpt-oss on Groq): faster, fewer reasoning tokens
LLM_PRICE_IN_PER_M=0.0              # optional USD per 1M input tokens, for cost accounting
LLM_PRICE_OUT_PER_M=0.0

RATE_LIMIT_PER_MIN=20
